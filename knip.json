{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/db/seed.ts",
    "src/modules/users/services/password.service.ts",
    "src/modules/users/services/token.service.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["awk"],
  "rules": {
    "unlisted": "error",
    "exports": "error",
    "types": "error"
  }
}
