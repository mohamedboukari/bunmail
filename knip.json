{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/db/reset-owner.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/db/seed.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["awk"],
  "rules": {
    "unlisted": "error",
    "exports": "error",
    "types": "error"
  }
}
