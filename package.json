{
  "name": "bunmail",
  "version": "0.9.0",
  "description": "Self-hosted email API for developers — free alternative to SendGrid/Resend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --type-aware src/",
    "lint:fix": "oxlint --type-aware src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint:xss": "bun run xss:toolchain && L=node_modules/.cache/xss-scan.log; node_modules/.cache/xss-toolchain/node_modules/.bin/xss-scan > $L 2>&1; cat $L; grep -q 'No XSS vulnerabilities found' $L",
    "test": "bun test test/unit test/e2e",
    "test:unit": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:integration": "bun test --preload ./test/integration/_preload.ts test/integration",
    "test:integration:setup": "bun run test/integration/setup-db.ts",
    "test:all": "bun test test/unit test/e2e && bun run test:integration",
    "test:coverage": "bun test test/unit test/e2e --coverage",
    "release": "bumpp",
    "prepare": "husky",
    "xss:toolchain": "D=node_modules/.cache/xss-toolchain; test -x $D/node_modules/.bin/xss-scan || (mkdir -p $D && printf '%s' '{\"name\":\"xss-toolchain\",\"private\":true}' > $D/package.json && bun add --cwd $D typescript@5.9.3 @kitajs/html@4.2.13 @kitajs/ts-html-plugin@4.1.4)"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix",
      "bash -c 'bunx tsc --noEmit'"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.6",
    "@types/smtp-server": "^3.5.13",
    "bumpp": "^12.3.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@kitajs/html": "^4.2.13",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "file-type": "^22.0.2",
    "mailparser": "^3.9.24",
    "nodemailer": "^10.0.3",
    "smtp-server": "^3.19.10"
  }
}
